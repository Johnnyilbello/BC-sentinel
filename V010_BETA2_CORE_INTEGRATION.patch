+    def recover_web_containment_state(self) -> dict[str, Any]:
+        now = time.time()
+        expired: list[str] = []
+        stale: list[str] = []
+        active: list[str] = []
+        observed = {str(row.get("rule_id") or "") for row in self.firewall.list_rules(500)}
